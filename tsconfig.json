{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"lib": ["es2022", "dom", "dom.iterable"],
		"paths": {
			"@/components/*": ["./src/components/*"],
			"@/layouts/*": ["./src/layouts/*"],
			"@/site-config": ["./src/site.config.ts"]
		}
	},
	"exclude": ["node_modules", "**/node_modules/*", ".vscode", "dist"]
}
