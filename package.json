{
	"name": "@telecrypt-io/www",
	"version": "0.5.12",
	"description": "TeleCrypt.io public landing site and documentation.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "22.23.2"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.md\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.2.4",
		"@astrojs/sitemap": "3.7.3",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"astro": "7.2.4",
		"rehype-external-links": "3.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.10",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"typescript": "6.0.3"
	}
}
