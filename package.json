{
	"name": "@telecrypt-io/www",
	"version": "0.5.6",
	"description": "TeleCrypt.io public landing site and documentation.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.19.0",
	"pnpm": {
		"overrides": {
			"@astrojs/language-server": "2.16.14",
			"fast-uri": "3.1.5",
			"js-yaml": "4.3.1",
			"nanoid": "3.3.18",
			"postcss": "8.5.26",
			"svgo": "4.0.2",
			"yaml": "2.8.3"
		}
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.md\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.2.2",
		"@astrojs/sitemap": "3.7.3",
		"@fontsource-variable/inter": "5.2.8",
		"@fontsource-variable/jetbrains-mono": "5.2.8",
		"astro": "7.2.2",
		"rehype-external-links": "3.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.2",
		"prettier": "3.9.4",
		"prettier-plugin-astro": "0.14.1",
		"typescript": "6.0.3"
	}
}
