---
import { llmsAuthorityUrl, siteConfig } from "@/site-config";

const copyright = `© ${siteConfig.author}`;
---

<footer class="site-footer">
	<span>{copyright}</span>
	<nav aria-label="Footer" class="right">
		<a href="/privacy/">Privacy</a>
		<span class="sep" aria-hidden="true">·</span>
		<a href="/support/">Support</a>
		<span class="sep" aria-hidden="true">·</span>
		<a class="machine-link" href={llmsAuthorityUrl} rel="noopener noreferrer">llms.txt</a>
	</nav>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--hairline);
		padding-top: 22px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px 18px;
		font-family: var(--font-sans);
		font-size: 12.5px;
		color: hsl(var(--theme-text) / 0.72);
		transition: border-color 0.35s ease;
	}
	.site-footer .right {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.site-footer .right .sep {
		color: var(--faint);
	}
	.site-footer a {
		color: hsl(var(--theme-text-muted));
		transition: color 0.2s ease;
	}
	.site-footer a:hover {
		color: hsl(var(--theme-accent));
	}
	.site-footer .machine-link {
		font-family: var(--font-mono);
		color: hsl(var(--theme-text) / 0.5);
	}
	.site-footer .machine-link:hover {
		color: hsl(var(--theme-accent));
	}

	@media (max-width: 420px) {
		.site-footer {
			font-size: 11.5px;
			gap: 12px;
		}
	}
</style>
