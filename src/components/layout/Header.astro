---
import { menuLinks } from "@/site-config";

const url = new URL(Astro.request.url);
const homePath = "/";
const isHome = url.pathname === homePath;

const isActive = (path: string) => {
	if (path.includes("#")) return false;
	if (path === "/") return url.pathname === path;
	return url.pathname === path || url.pathname.startsWith(path);
};
---

<header class="site-header" id="main-header">
	{
		isHome ? (
			<h1 class="brand">
				<a href={homePath} class="brand-link">
					<img
						class="brand-mark"
						src="/logo-mark.png"
						alt=""
						width="40"
						height="40"
						decoding="async"
					/>
					<span class="brand-text">
						TeleCrypt<span class="tld">.io</span>
					</span>
				</a>
			</h1>
		) : (
			<a href={homePath} class="brand-link">
				<img
					class="brand-mark"
					src="/logo-mark.png"
					alt=""
					width="40"
					height="40"
					decoding="async"
				/>
				<span class="brand-text">
					TeleCrypt<span class="tld">.io</span>
				</span>
			</a>
		)
	}
	<nav class="nav" aria-label="Primary">
		{
			menuLinks.map((link) => (
				<a
					aria-current={isActive(link.path) ? "page" : false}
					class:list={[{ active: isActive(link.path) }]}
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 28px;
	}
	.brand {
		margin: 0;
		font-size: inherit;
		font-weight: inherit;
	}
	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-sans);
		font-size: clamp(28px, 4vw, 40px);
		line-height: 1.02;
		letter-spacing: -0.045em;
		font-weight: 700;
		font-variation-settings: "wght" 700;
		color: hsl(var(--theme-text));
		transition: opacity 0.2s ease;
	}
	.brand-link:hover {
		opacity: 0.85;
	}
	.brand-mark {
		width: clamp(32px, 4.2vw, 40px);
		height: clamp(32px, 4.2vw, 40px);
		border-radius: 6px;
		flex-shrink: 0;
		display: block;
	}
	.brand-text {
		display: inline-block;
	}
	.tld {
		color: hsl(var(--theme-accent));
	}
	.nav {
		display: flex;
		align-items: baseline;
		gap: 22px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.65);
	}
	.nav a {
		display: inline-block;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.2s ease;
	}
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-text));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 20px;
			flex-wrap: wrap;
			row-gap: 12px;
		}
		.brand-link {
			font-size: clamp(26px, 7vw, 34px);
		}
		.nav {
			gap: 16px;
			font-size: 13px;
			flex-wrap: wrap;
		}
		.nav a {
			padding-top: 4px;
		}
	}

	@media (max-width: 420px) {
		.nav {
			gap: 14px;
			font-size: 12.5px;
		}
	}
</style>
