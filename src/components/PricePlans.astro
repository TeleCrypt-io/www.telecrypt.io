---
import { planUrl, seatPrice } from "@/site-config";
---

<div class="plans">
	<article class="plan">
		<div class="plan-head">
			<h2 class="plan-name">Early bird</h2>
			<p class="plan-price">{seatPrice}</p>
		</div>
		<ul class="plan-list">
			<li>Chats</li>
			<li>Storage</li>
		</ul>
		<a class="plan-link" href={planUrl}>Let's go</a>
	</article>
</div>

<style>
	.plans {
		display: flex;
		justify-content: center;
		text-align: center;
	}
	.plan {
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 32ch;
	}
	.plan-head {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 14px;
		margin: 0 0 12px;
		flex-wrap: wrap;
	}
	.plan-name {
		font-family: var(--font-sans);
		font-size: clamp(22px, 2.8vw, 28px);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.plan-price {
		font-family: var(--font-sans);
		font-size: clamp(22px, 2.8vw, 28px);
		font-weight: 700;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		color: hsl(var(--theme-accent));
		margin: 0;
	}
	.plan-list {
		list-style: none;
		padding: 0;
		margin: 0 0 16px;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.55;
		color: hsl(var(--theme-text) / 0.92);
	}
	.plan-list li {
		margin: 0;
	}
	.plan-list li::before {
		content: "· ";
		color: hsl(var(--theme-accent));
		font-weight: 700;
	}
	.plan-link {
		display: inline-flex;
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 600;
		color: hsl(var(--theme-bg));
		background: hsl(var(--theme-accent));
		padding: 10px 18px;
		border-radius: 3px;
		transition: background-color 0.2s ease;
	}
	.plan-link:hover {
		background: hsl(14deg 100% 72%);
	}
</style>
