---
import PageLayout from "@/layouts/Base.astro";

interface Props {
	title: string;
	description?: string;
	label?: string;
}

const { title, description, label } = Astro.props;
const meta = { title, description: description ?? title };
const heading = label ?? title;
---

<PageLayout meta={meta}>
	<section class="page">
		<header class="page-intro">
			<h1 class="page-title">{heading}</h1>
		</header>
		<div class="page-body prose">
			<slot />
		</div>
	</section>
</PageLayout>

<style>
	.page {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 8px 0 48px;
		width: 100%;
	}
	.page-intro {
		width: 100%;
		max-width: 40rem;
		text-align: center;
		margin-bottom: 28px;
	}
	.page-title {
		font-family: var(--font-sans);
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.page-body {
		width: 100%;
		max-width: 40rem;
		text-align: left;
	}
	.prose {
		font-family: var(--font-sans);
		font-size: 17px;
		line-height: 1.7;
		color: hsl(var(--theme-text) / 0.88);
	}
	.prose :global(h2) {
		font-family: var(--font-sans);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 34px 0 10px;
		color: hsl(var(--theme-text));
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.prose :global(p) {
		margin: 0 0 22px;
		text-wrap: pretty;
	}
	.prose :global(p:last-child) {
		margin-bottom: 0;
	}
	.prose :global(a) {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-underline-offset: 3px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}
	.prose :global(a:hover) {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: hsl(var(--theme-text) / 0.08);
		padding: 1px 5px;
		border-radius: 4px;
	}
	@media (max-width: 720px) {
		.page {
			padding: 4px 0 36px;
		}
		.page-intro {
			margin-bottom: 22px;
		}
		.prose {
			font-size: 16.5px;
			line-height: 1.65;
		}
	}
</style>
