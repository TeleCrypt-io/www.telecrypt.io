---
import PageLayout from "@/layouts/Base.astro";
import PricePlans from "@/components/PricePlans.astro";
import { seatPrice } from "@/site-config";

const meta = {
	title: "Price",
	description: `TeleCrypt early bird — chats, calls, and storage for ${seatPrice}.`,
};
---

<PageLayout meta={meta}>
	<section class="price-page">
		<header class="page-intro">
			<h1 class="page-title">Price</h1>
		</header>
		<div class="page-body">
			<PricePlans />
		</div>
	</section>
</PageLayout>

<style>
	.price-page {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 8px 0 48px;
		width: 100%;
	}
	.page-intro {
		width: 100%;
		max-width: 36rem;
		text-align: center;
		margin-bottom: 36px;
	}
	.page-title {
		font-family: var(--font-sans);
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.page-body {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	@media (max-width: 720px) {
		.price-page {
			padding: 4px 0 36px;
		}
		.page-intro {
			margin-bottom: 28px;
		}
	}
</style>
