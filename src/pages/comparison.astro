---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	title: "Comparison",
	description: "Business messengers compared — open source, self-hosted, end-to-end encryption.",
};
---

<PageLayout meta={meta}>
	<section class="comparison">
		<header class="page-intro">
			<h1 class="page-title">Comparison</h1>
			<p class="page-lede">
				Business messengers as of 5 March 2026 — open source, self-hosted, end-to-end encryption.
			</p>
		</header>

		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>Messenger</th>
						<th>Open Source<br /><span class="th-sub">Server &amp; Client</span></th>
						<th>True E2EE<br /><span class="th-sub">Default + Forward Secrecy</span></th>
						<th>Trust Model<br /><span class="th-sub">Architecture</span></th>
						<th>Kubernetes Req?<br /><span class="th-sub">Prod Server</span></th>
						<th>Federation Support</th>
						<th>E2EE Sync<br /><span class="th-sub">Mobile ↔ Desktop</span></th>
						<th>E2EE Calls<br /><span class="th-sub">1:1 &amp; Group</span></th>
						<th>Vendor Lock-in</th>
					</tr>
				</thead>
				<tbody>
					<tr class="tier-gold">
						<td>Element <span class="note">Matrix protocol</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-zero">Zero-Trust</span>
							<span class="note">Cryptographic verification</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Docker / Python is enough</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Native Server-to-Server</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Cross-signing</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Element Call (WebRTC)</span>
						</td>
						<td>
							<span class="lockin lockin-low">Low</span>
							<span class="note">Open protocol</span>
						</td>
					</tr>

					<tr class="tier-gold">
						<td>Wire</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-enterprise">Trusted Enterprise</span>
							<span class="note">E2EE, but central authority</span>
						</td>
						<td>
							<span class="k8s k8s-yes">Yes</span>
							<span class="note">Mandatory for Wire backend</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Enterprise Federation only</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Up to 8 devices</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Built-in WebRTC</span>
						</td>
						<td>
							<span class="lockin lockin-med">Medium</span>
							<span class="note">Tightly coupled system</span>
						</td>
					</tr>

					<tr class="tier-silver">
						<td>XMPP <span class="note">Conversations / Dino</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Opt-in (via OMEMO)</span>
						</td>
						<td>
							<span class="trust trust-enterprise">Trusted Server</span>
							<span class="note">With Zero-Trust OMEMO overlay</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Lightweight binaries/Docker</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Native Server-to-Server</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Modern OMEMO clients only</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">1:1 native; Group via Jitsi</span>
						</td>
						<td>
							<span class="lockin lockin-low">Low</span>
							<span class="note">Vast open ecosystem</span>
						</td>
					</tr>

					<tr class="tier-silver">
						<td>Jami</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-zero">Zero-Trust</span>
							<span class="note">Pure P2P</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">No server needed (P2P)</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">P2P mesh, no federation</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Swarm feature</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">P2P native</span>
						</td>
						<td>
							<span class="lockin lockin-low">Low</span>
							<span class="note">You own your keys</span>
						</td>
					</tr>

					<tr class="tier-silver">
						<td>Rocket.Chat</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Core only</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Opt-in / Partial FW secrecy</span>
						</td>
						<td>
							<span class="trust trust-enterprise">Trusted Enterprise</span>
							<span class="note">E2EE is an overlay</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Docker / Snap / Tarball</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Via Matrix-compatible engine</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Where E2EE is enabled</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Requires Jitsi plugin</span>
						</td>
						<td>
							<span class="lockin lockin-med">Medium</span>
							<span class="note">Open core</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>SimpleX Chat</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-zero">Zero-Trust</span>
							<span class="note">No user identifiers</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Lightweight relay binaries</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Isolated relays</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Isolated by design</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">1:1 only</span>
						</td>
						<td>
							<span class="lockin lockin-low">Low</span>
							<span class="note">Exportable DB</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Mattermost</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Core only</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">In-transit/at-rest only</span>
						</td>
						<td>
							<span class="trust trust-enterprise">Trusted Enterprise</span>
							<span class="note">Server has full access</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Docker / Binary</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Shared Channels feature only</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">No true E2EE</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Requires Calls plugin</span>
						</td>
						<td>
							<span class="lockin lockin-med">Medium</span>
							<span class="note">Proprietary schema</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Wickr <span class="note">AWS</span></td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Proprietary</span>
						</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-enterprise">Trusted Enterprise</span>
							<span class="note">E2EE payload, central admin</span>
						</td>
						<td>
							<span class="k8s k8s-yes">Yes</span>
							<span class="note">Enterprise On-Prem requires K8s</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Wickr-to-Wickr network</span>
						</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Proprietary backend</span>
						</td>
						<td>
							<span class="lockin lockin-high">High</span>
							<span class="note">Amazon ecosystem</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Session</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-zero">Zero-Trust</span>
							<span class="note">Decentralized nodes</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Global decentralized nodes</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Onion-routed network</span>
						</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">1:1 beta only</span>
						</td>
						<td>
							<span class="lockin lockin-low">Low</span>
							<span class="note">Decentralized network</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Threema</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Client only</span>
						</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-enterprise">Trusted Server</span>
							<span class="note">E2EE, but central router</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">Docker available for OnPrem</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Closed network</span>
						</td>
						<td>
							<span class="mark mark-yes">Yes</span>
							<span class="note">Threema 2.0</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Proprietary backend</span>
						</td>
						<td>
							<span class="lockin lockin-high">High</span>
							<span class="note">Proprietary server</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Signal</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-zero">Zero-Trust</span>
							<span class="note">SGX Enclaves / TOFU</span>
						</td>
						<td>
							<span class="k8s k8s-na">N/A</span>
							<span class="note">Not practical to self-host</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Walled garden</span>
						</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Cannot self-host</span>
						</td>
						<td>
							<span class="lockin lockin-high">High</span>
							<span class="note">No third-party clients</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Briar</td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-zero">Zero-Trust</span>
							<span class="note">Device-to-Device</span>
						</td>
						<td>
							<span class="k8s k8s-no">No</span>
							<span class="note">P2P</span>
						</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Tor/Bluetooth</span>
						</td>
						<td><span class="mark mark-no">No</span></td>
						<td><span class="mark mark-no">No</span></td>
						<td>
							<span class="lockin lockin-low">Low</span>
							<span class="note">Open source P2P</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>WhatsApp</td>
						<td><span class="mark mark-no">No</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td>
							<span class="trust trust-enterprise">Trusted Server</span>
							<span class="note">Meta manages metadata</span>
						</td>
						<td>
							<span class="k8s k8s-na">N/A</span>
							<span class="note">Not self-hostable</span>
						</td>
						<td><span class="mark mark-no">No</span></td>
						<td><span class="mark mark-yes">Yes</span></td>
						<td><span class="mark mark-no">No</span></td>
						<td>
							<span class="lockin lockin-high">High</span>
							<span class="note">Meta ecosystem</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Telegram</td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Client only</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Secret Chats only</span>
						</td>
						<td>
							<span class="trust trust-enterprise">Trusted Server</span>
							<span class="note">Server holds cloud keys</span>
						</td>
						<td>
							<span class="k8s k8s-na">N/A</span>
							<span class="note">Not self-hostable</span>
						</td>
						<td><span class="mark mark-no">No</span></td>
						<td>
							<span class="mark mark-no">No</span>
							<span class="note">Secret Chats do not sync</span>
						</td>
						<td><span class="mark mark-no">No</span></td>
						<td>
							<span class="lockin lockin-high">High</span>
							<span class="note">Proprietary cloud</span>
						</td>
					</tr>

					<tr class="tier-none">
						<td>Slack / Teams</td>
						<td><span class="mark mark-no">No</span></td>
						<td><span class="mark mark-no">No</span></td>
						<td>
							<span class="trust trust-enterprise">Trusted Enterprise</span>
							<span class="note">Full server visibility</span>
						</td>
						<td>
							<span class="k8s k8s-na">N/A</span>
							<span class="note">SaaS only</span>
						</td>
						<td>
							<span class="mark mark-partial">Partial</span>
							<span class="note">Slack Connect / Guest</span>
						</td>
						<td><span class="mark mark-no">No</span></td>
						<td><span class="mark mark-no">No</span></td>
						<td>
							<span class="lockin lockin-high">High</span>
							<span class="note">SaaS monopoly</span>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<ul class="legend">
			<li><span class="mark mark-yes">Yes</span> Fully supported</li>
			<li><span class="mark mark-partial">Partial</span> Caveats / extra config</li>
			<li><span class="mark mark-no">No</span> Not supported</li>
			<li><span class="dot dot-gold"></span> Meets all business requirements</li>
			<li><span class="dot dot-silver"></span> Partially meets requirements</li>
			<li><span class="dot dot-none"></span> Does not meet requirements</li>
		</ul>
	</section>
</PageLayout>

<style>
	.comparison {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 8px 0 48px;
		width: 100%;
	}
	.page-intro {
		width: 100%;
		max-width: 40rem;
		text-align: center;
		margin-bottom: 28px;
	}
	.page-title {
		font-family: var(--font-sans);
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: hsl(var(--theme-text));
		margin: 0 0 12px;
	}
	.page-lede {
		font-family: var(--font-sans);
		font-size: 15.5px;
		line-height: 1.5;
		color: hsl(var(--theme-text) / 0.78);
		margin: 0 auto;
		max-width: 42ch;
	}

	.table-wrap {
		width: 100%;
		overflow-x: auto;
		border: 1px solid var(--hairline);
		border-radius: 4px;
		background: var(--paper);
	}
	table {
		width: 100%;
		min-width: 1100px;
		border-collapse: collapse;
		font-family: var(--font-sans);
		font-size: 13px;
		line-height: 1.45;
	}
	thead th {
		background: hsl(var(--theme-bg));
		color: hsl(var(--theme-text) / 0.9);
		padding: 12px 10px;
		text-align: center;
		font-weight: 600;
		font-size: 12px;
		letter-spacing: -0.01em;
		border-bottom: 1px solid var(--hairline);
		vertical-align: bottom;
	}
	thead th:first-child {
		text-align: left;
		min-width: 140px;
		padding-left: 14px;
	}
	.th-sub {
		display: block;
		font-weight: 400;
		font-size: 11px;
		color: hsl(var(--theme-text) / 0.5);
		margin-top: 2px;
	}
	tbody td {
		padding: 10px;
		text-align: center;
		border-bottom: 1px solid var(--hairline);
		vertical-align: top;
		color: hsl(var(--theme-text) / 0.9);
	}
	tbody tr:last-child td {
		border-bottom: none;
	}
	tbody td:first-child {
		text-align: left;
		font-weight: 700;
		letter-spacing: -0.02em;
		white-space: nowrap;
		padding-left: 14px;
		color: hsl(var(--theme-text));
	}
	tbody tr:hover td {
		background: hsl(var(--theme-text) / 0.03);
	}
	.note {
		display: block;
		font-size: 11px;
		font-weight: 400;
		color: hsl(var(--theme-text) / 0.48);
		margin-top: 3px;
		white-space: normal;
	}

	.mark {
		font-weight: 600;
		font-size: 12px;
		letter-spacing: -0.01em;
	}
	.mark-yes {
		color: hsl(var(--theme-text));
	}
	.mark-partial {
		color: hsl(var(--theme-accent));
	}
	.mark-no {
		color: hsl(var(--theme-text) / 0.45);
	}

	.lockin {
		font-weight: 600;
	}
	.lockin-low {
		color: hsl(var(--theme-text));
	}
	.lockin-med {
		color: hsl(var(--theme-accent));
	}
	.lockin-high {
		color: hsl(var(--theme-text) / 0.5);
	}

	.k8s {
		font-weight: 700;
	}
	.k8s-no {
		color: hsl(var(--theme-text));
	}
	.k8s-yes {
		color: hsl(var(--theme-accent));
	}
	.k8s-na {
		color: hsl(var(--theme-text) / 0.45);
	}

	.trust {
		font-weight: 600;
	}
	.trust-zero {
		color: hsl(var(--theme-text));
	}
	.trust-enterprise {
		color: hsl(var(--theme-text) / 0.75);
	}

	tr.tier-gold td:first-child {
		box-shadow: inset 3px 0 0 hsl(var(--theme-accent));
	}
	tr.tier-silver td:first-child {
		box-shadow: inset 3px 0 0 hsl(var(--theme-text) / 0.45);
	}
	tr.tier-none td:first-child {
		box-shadow: inset 3px 0 0 hsl(var(--theme-text) / 0.15);
	}

	.legend {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		justify-content: center;
		margin: 22px 0 0;
		padding: 0;
		font-family: var(--font-sans);
		font-size: 12.5px;
		color: hsl(var(--theme-text) / 0.65);
		max-width: 900px;
	}
	.legend li {
		display: flex;
		align-items: center;
		gap: 7px;
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.dot-gold {
		background: hsl(var(--theme-accent));
	}
	.dot-silver {
		background: hsl(var(--theme-text) / 0.45);
	}
	.dot-none {
		background: transparent;
		border: 1px solid hsl(var(--theme-text) / 0.3);
	}

