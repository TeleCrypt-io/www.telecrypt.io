---
import { getEntry, render } from "astro:content";
import Page from "@/components/Page.astro";
import { siteConfig } from "@/site-config";

const entry = await getEntry("page", "about");
if (!entry) throw new Error("Missing src/content/page/about.md");
const { Content } = await render(entry);

const meta = {
	description: entry.data.description ?? siteConfig.description,
	title: entry.data.title,
};

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	url: new URL("/about/", Astro.site).href,
	mainEntity: {
		"@type": "Organization",
		name: siteConfig.title,
		url: new URL("/", Astro.site).href,
		logo: new URL("/logo-mark.png", Astro.site).href,
	},
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

<Page title={meta.title} description={meta.description} label="About">
	<Content />
</Page>
