---
import Page from "@/components/Page.astro";

const meta = {
	title: "Support",
	description: "Contact TeleCrypt support for account issues, bug reports, or anything else.",
};
---

<Page title={meta.title} description={meta.description} prose={false}>
	<p class="page-lede">
		Account issues, bug reports, or anything else — write to us and we’ll get back to you.
	</p>
	<a class="cta" href="mailto:support@telecrypt.io">support@telecrypt.io</a>
</Page>

<style>
	.page-lede {
		font-family: var(--font-sans);
		font-size: 15.5px;
		line-height: 1.5;
		color: hsl(var(--theme-text) / 0.78);
		margin: 0 auto 28px;
		max-width: 36ch;
		text-align: center;
	}
	.cta {
		display: flex;
		width: fit-content;
		margin: 0 auto;
		font-family: var(--font-sans);
		font-size: 15px;
		font-weight: 600;
		color: hsl(var(--theme-bg));
		background: hsl(var(--theme-accent));
		padding: 12px 22px;
		border-radius: 3px;
		transition: background-color 0.2s ease;
	}
	.cta:hover {
		background: hsl(14deg 100% 72%);
	}

	@media (max-width: 720px) {
		.page-lede {
			margin-bottom: 22px;
		}
	}
</style>
