---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "The page you were looking for doesn't exist.",
	title: "404 — Not found",
};
---

<PageLayout meta={meta}>
	<section class="page">
		<header class="page-intro">
			<p class="eyebrow">Error · 404</p>
			<h1 class="page-title">This page wandered off.</h1>
		</header>
		<div class="page-body">
			<p>
				The page you were looking for doesn't exist. It may have been moved, renamed, or just isn't
				there yet. Try the <a href="/">home</a> page, or read
				<a href="/about/">about</a> TeleCrypt.
			</p>
		</div>
	</section>
</PageLayout>

<style>
	.page {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 8px 0 80px;
		width: 100%;
		text-align: center;
	}
	.page-intro {
		width: 100%;
		max-width: 36rem;
		margin-bottom: 20px;
	}
	.eyebrow {
		font-family: var(--font-sans);
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: hsl(var(--theme-text) / 0.5);
		margin: 0 0 14px;
	}
	.page-title {
		font-family: var(--font-sans);
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.page-body {
		font-family: var(--font-sans);
		font-size: 17px;
		line-height: 1.65;
		color: hsl(var(--theme-text) / 0.78);
		max-width: 36rem;
	}
	.page-body p {
		margin: 0;
	}
	.page-body a {
		color: hsl(var(--theme-text));
		border-bottom: 1px solid hsl(var(--theme-accent) / 0.55);
		padding-bottom: 1px;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.page-body a:hover {
		color: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent));
	}
</style>
